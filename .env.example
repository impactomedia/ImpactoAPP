# Impacto Nexora
# Copia este archivo como .env para desarrollo local.
# Nunca subas credenciales reales al repositorio.

SECRET_KEY=replace-with-a-long-random-secret

# Base de datos.
# Si DATABASE_URL no está definida, desarrollo local usa SQLite.
# Ejemplo MySQL:
DATABASE_URL=mysql+pymysql://impacto_user:strong_password@127.0.0.1:3306/impacto_manager

COMPANY_NAME=Impacto Media Agency
COMPANY_TIMEZONE=America/Managua

# Uploads / persistencia
MAX_UPLOAD_MB=20
MAX_FILE_UPLOAD_MB=20
UPLOAD_FOLDER=app/static/uploads
BACKUP_DIR=backups

# Listados / DB pool
LIST_PAGE_SIZE=25
LIST_MAX_PAGE_SIZE=100
DB_POOL_RECYCLE_SECONDS=1800

# Cookies.
# En producción HTTPS deben quedar en 1.
SESSION_COOKIE_SECURE=1
REMEMBER_COOKIE_SECURE=1

# Usuario inicial para una base nueva.
ADMIN_NAME=Administrador General
ADMIN_EMAIL=admin@impactomedia.local
ADMIN_PASSWORD=ChangeMe123!

# SMTP opcional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# Backups
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_FILES=30

# Scheduler de backup: opcionales.
AUTO_BACKUP_INITIAL_DELAY_SECONDS=75
AUTO_BACKUP_CHECK_SECONDS=300

# Desactiva el hilo automático solo para diagnóstico/tests controlados.
# NEXORA_DISABLE_AUTO_BACKUP_THREAD=1

# Restore drill:
# SOLO apuntar a una base de pruebas separada.
# RESTORE_DATABASE_URL=mysql+pymysql://usuario:clave@host:3306/base_temporal
